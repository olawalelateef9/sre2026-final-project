{
  "title": "Techbleat Global Bank: service health",
  "description": "Golden signals at the public gateway, per-service saturation, data services and security events. Managed by Terraform (infra/datadog).",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Availability and traffic",
        "layout_type": "ordered",
        "widgets": [
          {"definition": {"type": "slo", "title": "Public availability SLO (99.5%)", "view_type": "detail", "slo_id": "${slo_id}", "time_windows": ["7d", "30d"], "view_mode": "overall", "show_error_budget": true}},
          {"definition": {"type": "timeseries", "title": "Gateway requests by status", "requests": [{"q": "sum:${gateway_requests} by {response_code}.as_count()", "display_type": "bars"}]}},
          {"definition": {"type": "query_value", "title": "5xx error rate (last hour)", "precision": 2, "requests": [{"q": "100 * sum:${gateway_errors}.as_count() / sum:${gateway_requests}.as_count()", "aggregator": "sum"}], "custom_unit": "%"}},
          {"definition": {"type": "timeseries", "title": "Requests by destination service", "requests": [{"q": "sum:istio.mesh.request.count.total{reporter:destination,kube_namespace:banking} by {destination_service_name}.as_count()", "display_type": "line"}]}}
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Latency",
        "layout_type": "ordered",
        "widgets": [
          {"definition": {"type": "timeseries", "title": "Average gateway latency (ms)", "requests": [{"q": "sum:istio.mesh.request.duration.milliseconds.sum.total{reporter:source,source_workload:public-istio}.as_count() / sum:istio.mesh.request.duration.milliseconds.count.total{reporter:source,source_workload:public-istio}.as_count()", "display_type": "line"}]}},
          {"definition": {"type": "timeseries", "title": "p95 span duration by service (traces)", "requests": [{"q": "p95:trace.envoy.proxy{*} by {service}", "display_type": "line"}]}}
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Saturation",
        "layout_type": "ordered",
        "widgets": [
          {"definition": {"type": "timeseries", "title": "Memory used vs limit, banking workloads", "requests": [{"q": "avg:kubernetes.memory.usage_pct{kube_cluster_name:techbleat,kube_namespace:banking} by {kube_deployment}", "display_type": "line"}]}},
          {"definition": {"type": "timeseries", "title": "CPU by workload (cores)", "requests": [{"q": "sum:kubernetes.cpu.usage.total{kube_cluster_name:techbleat,kube_namespace:banking} by {kube_deployment} / 1000000000", "display_type": "line"}]}},
          {"definition": {"type": "timeseries", "title": "Node CPU (%)", "requests": [{"q": "avg:system.cpu.user{kube_cluster_name:techbleat} by {host}", "display_type": "line"}]}},
          {"definition": {"type": "timeseries", "title": "Container restarts", "requests": [{"q": "sum:kubernetes.containers.restarts{kube_cluster_name:techbleat} by {kube_namespace,pod_name}", "display_type": "bars"}]}}
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Data services and identity",
        "layout_type": "ordered",
        "widgets": [
          {"definition": {"type": "timeseries", "title": "RDS CPU (%)", "requests": [{"q": "avg:aws.rds.cpuutilization{dbinstanceidentifier:techbleat-*} by {dbinstanceidentifier}", "display_type": "line"}]}},
          {"definition": {"type": "timeseries", "title": "RDS connections", "requests": [{"q": "avg:aws.rds.database_connections{dbinstanceidentifier:techbleat-*} by {dbinstanceidentifier}", "display_type": "line"}]}},
          {"definition": {"type": "timeseries", "title": "Valkey CPU (%)", "requests": [{"q": "avg:aws.elasticache.cpuutilization{replication_group:techbleat-valkey}", "display_type": "line"}]}},
          {"definition": {"type": "query_value", "title": "Kafka broker ready", "requests": [{"q": "sum:kubernetes_state.pod.ready{kube_cluster_name:techbleat,kube_namespace:banking,pod_name:banking-kafka-dual-role-0,condition:true}", "aggregator": "last"}]}},
          {"definition": {"type": "query_value", "title": "Keycloak tasks running (ECS)", "requests": [{"q": "avg:aws.ecs.service.running{clustername:techbleat-identity,servicename:keycloak}", "aggregator": "last"}]}}
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Security events",
        "layout_type": "ordered",
        "widgets": [
          {"definition": {"type": "timeseries", "title": "Authentication failures and authorization denials", "requests": [
            {"log_query": {"index": "*", "search": {"query": "authentication_failed"}, "compute": {"aggregation": "count"}, "group_by": []}, "display_type": "bars"},
            {"log_query": {"index": "*", "search": {"query": "authorization_denied"}, "compute": {"aggregation": "count"}, "group_by": []}, "display_type": "bars"}
          ]}},
          {"definition": {"type": "log_stream", "title": "Security audit events (tokens are scrubbed by the Agent)", "query": "authentication_failed OR authorization_denied", "columns": ["host", "service"], "show_date_column": true, "show_message_column": true, "message_display": "expanded-md", "sort": {"column": "time", "order": "desc"}}}
        ]
      }
    }
  ]
}
