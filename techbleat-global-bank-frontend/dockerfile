# Base images pinned by digest; Dependabot proposes updates as reviewed pull requests.

# Build stage
FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Keycloak settings are compiled into the bundle; override per environment at build time.
ARG VITE_KEYCLOAK_URL=http://localhost:8080
ARG VITE_KEYCLOAK_REALM=banking
ARG VITE_KEYCLOAK_CLIENT_ID=banking-frontend
RUN npm run build


# Runtime stage: runs as the unprivileged nginx user (UID 101) on port 8080.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03

# Values substituted into templates/default.conf.template at start. Defaults match Docker Compose.
ENV KEYCLOAK_ORIGIN=http://localhost:8080 \
    USER_SERVICE_UPSTREAM=user-service:8000 \
    TRANSACTION_SERVICE_UPSTREAM=transaction-service:8080 \
    ACTIVITY_SERVICE_UPSTREAM=activity-service:8001 \
    FINANCE_AGENT_UPSTREAM=finance-agent:9001

# Apply OS security updates published since the pinned base image was built.
USER root
RUN apk upgrade --no-cache
USER 101

COPY templates/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/frontend-health || exit 1
